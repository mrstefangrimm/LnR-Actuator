{
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "compileOnSave": false,
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist/out-tsc",
    "strict": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "paths": {
      "threeobject": ["./projects/threeobject/src/public-api"],
      "overlaybutton": ["./projects/overlaybutton/src/public-api"]
    }
  },
  "references": [
    {
      "path": "./projects/overlaybutton/tsconfig.lib.json"
    },
    {
      "path": "./projects/threeobject/tsconfig.lib.json"
    }
  ]
}
